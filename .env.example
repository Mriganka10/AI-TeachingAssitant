APP_NAME=Professor AI Workspace
ENVIRONMENT=local
SECRET_KEY=replace-with-a-long-random-application-secret
DATABASE_URL=sqlite:///./data/professor_ai.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
LLM_SERVICE_MODE=openai
AUTH_ENABLED=true
OTP_DEV_MODE=true
OTP_TTL_MINUTES=10
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.edu
STORAGE_PROVIDER=local
S3_BUCKET=
S3_PREFIX=professor-ai
S3_KMS_KEY_ID=
AWS_REGION=ap-south-1
MAX_UPLOAD_MB=50
MAX_CONTEXT_CHARS=120000
OCR_ENABLED=true
OCR_PROVIDER=local
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARS=80
OCR_MAX_PAGES=100
