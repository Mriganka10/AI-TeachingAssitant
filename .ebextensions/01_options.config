option_settings:
  aws:elasticbeanstalk:application:environment:
    ENVIRONMENT: production
    AUTH_ENABLED: "true"
    OTP_DEV_MODE: "false"
    STORAGE_PROVIDER: s3
    COOKIE_SECURE: "true"
    OCR_ENABLED: "true"
    OCR_PROVIDER: textract
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: app/static
